#!/bin/sh
# Launch the VTR editor (dev mode) from the repo root.
# Usage: ./run [path/to/project.oscproj]
set -e
cd "$(dirname "$0")"

# Dev spawns vtr-tap and vtr-player from vtr-tap/target; build the
# workspace (both binaries) if either is missing.
have() { [ -x "vtr-tap/target/release/$1" ] || [ -x "vtr-tap/target/debug/$1" ]; }
if ! have vtr-tap || ! have vtr-player; then
  echo "building vtr-tap workspace..."
  (cd vtr-tap && cargo build --release)
fi

if [ ! -d vtr-editor/node_modules ]; then
  echo "installing editor deps..."
  (cd vtr-editor && npm install)
fi

cd vtr-editor
exec npm run dev -- "$@"
