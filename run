#!/bin/sh
# Launch the VTR editor (dev mode) from the repo root.
# Usage: ./run [path/to/project.oscproj]
set -e
cd "$(dirname "$0")"

# Dev spawns osc-tap and vtr-player from osc-tap/target; build the
# workspace (both binaries) if either is missing.
have() { [ -x "osc-tap/target/release/$1" ] || [ -x "osc-tap/target/debug/$1" ]; }
if ! have osc-tap || ! have vtr-player; then
  echo "building osc-tap workspace..."
  (cd osc-tap && cargo build --release)
fi

if [ ! -d osc-editor/node_modules ]; then
  echo "installing editor deps..."
  (cd osc-editor && npm install)
fi

cd osc-editor
exec npm run dev -- "$@"
